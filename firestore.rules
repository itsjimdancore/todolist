rules_version = '2';

// =====================================================================
//  Firestore rules for this project. Two apps share it:
//    1. The graduation site: messages, wall-messages, speeches, rsvps,
//       graduationPhotos, aspirations, afterparty_waitlist
//    2. Shared To-Do Lists: users, lists (+ tasks, comments), invites, mail
//
//  Paste this whole file into Firebase console → Firestore Database → Rules,
//  or run `npm run deploy:rules`. Either way it replaces the published rules,
//  so keep both apps' sections in this one file.
//
//  To-do data layout
//    users/{uid}                         profile, the list you had open last, your favourite lists, your list order,
//                                        your Spotify player link, the songs on your Music page
//    people/{email}                      name, photo and when you were last active (fetched by people who know your email)
//    users/{uid}/log/{id}              my own activity, shown to me in Notifications ("You created …")
//    lists/{listId}                      title, owner, and who it's shared with
//                                        (kind: 'letter' = a love letter: a body, shared with one person at most):
//        roles:        { "friend@mail.com": "read" | "comment" | "write" | "readwrite" }
//        memberEmails: [ "friend@mail.com", ... ]   (same emails, for searching)
//        leftEmails:   [ "gone@mail.com", ... ]     (left on their own; shown to the owner until re-shared)
//    lists/{listId}/tasks/{taskId}
//    lists/{listId}/comments/{commentId}
//    invites/{listId_email}              in-app "shared with you" notification for one person
//    activity/{id}                       in-app "X did something on a list you share" notification for one person
//    pushTokens/{token}                  a device that turned on device notifications (read only by the server)
//    mail/{id}                           optional invitation emails (Trigger Email extension)
// =====================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // =================================================================
    //  EXISTING APP (graduation site) — unchanged
    // =================================================================

    // Contact form submissions — anyone can create, only admins can read
    match /messages/{docId} {
      allow create: if true;
      allow read, update, delete: if false;
    }

    // Memory wall — anyone can read, create, and update (for likes)
    match /wall-messages/{docId} {
      allow read: if true;
      allow create: if request.resource.data.sender is string
                    && request.resource.data.message is string;
      allow update: if request.resource.data.diff(resource.data).affectedKeys()
                      .hasOnly(['reactions']);
      allow delete: if false;
    }

    // Speeches — auth required for writes, field validation on create
    match /speeches/{docId} {
      allow read: if true;
      allow create: if request.auth != null
                    && request.resource.data.keys().hasAll(['recipient', 'title', 'initialText', 'createdAt'])
                    && request.resource.data.recipient is string
                    && request.resource.data.title is string
                    && request.resource.data.initialText is string;
      allow update: if request.auth != null
                    && request.resource.data.keys().hasAny(['recipient', 'title', 'relation', 'initialText', 'timeEstimate', 'avatarColor', 'icon', 'updatedAt']);
      allow delete: if request.auth != null;
    }

    // RSVP — anyone can create, public read
    match /rsvps/{docId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasAll(
        ['registrantName', 'registrantEmail', 'companions', 'ticketId', 'createdAt']
      );
      allow update, delete: if false;
    }

    // Gallery - read and write rule
    match /graduationPhotos/{docId} {
      allow read: if true;
      allow create, delete: if request.auth != null;
    }

    match /aspirations/{docId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null;
    }

    // Afterparty waitlist — public create, auth required for read/delete
    match /afterparty_waitlist/{docId} {
      allow create: if request.resource.data.keys().hasAll(['email', 'createdAt'])
                    && request.resource.data.email is string;
      allow read, delete: if request.auth != null;
      allow update: if false;
    }

    // =================================================================
    //  SHARED TO-DO APP — collections: users, lists (+ tasks, comments), invites, mail
    // =================================================================

    // ---------- helpers ----------
    function signedIn() { return request.auth != null; }
    function myEmail()  { return request.auth.token.email.lower(); }
    function hasEmail() { return signedIn() && request.auth.token.email is string; }

    function listData(listId) {
      return get(/databases/$(database)/documents/lists/$(listId)).data;
    }

    // 'owner' | 'read' | 'comment' | 'write' | 'readwrite' | null
    function roleIn(list) {
      return !signedIn() ? null
        : list.ownerId == request.auth.uid ? 'owner'
        : hasEmail() ? list.roles.get(myEmail(), null)
        : null;
    }
    // Calendar sharing: calendarShares/{ownerUid}_{email} lets that email see and change every to-do list
    // the owner has (not love letters), as if each were shared with them to edit (see calendarShares below)
    function calShared(list) {
      return hasEmail() && kindOf(list) == 'list'
        && exists(/databases/$(database)/documents/calendarShares/$(list.ownerId + '_' + myEmail()));
    }
    // roleIn, or 'write' through a shared calendar
    function effRole(list) {
      return roleIn(list) != null ? roleIn(list) : calShared(list) ? 'write' : null;
    }
    function canRead(role)    { return role != null; }
    function canWrite(role)   { return role in ['owner', 'write', 'readwrite']; }
    function canComment(role) { return role in ['owner', 'comment', 'readwrite']; }

    function validRoles(d) {
      return d.roles is map
        && d.memberEmails is list
        && d.memberEmails.size() <= 100
        && d.memberEmails.toSet() == d.roles.keys().toSet()
        && d.roles.values().toSet().difference(['read', 'comment', 'write', 'readwrite'].toSet()).size() == 0
        && !(d.ownerEmail in d.memberEmails);
    }
    // People who left on their own. The owner sees them until sharing with them again.
    function leftOf(d) { return d.get('leftEmails', []); }
    function validLeft(d) {
      return leftOf(d) is list
        && leftOf(d).size() <= 100
        && leftOf(d).toSet().intersection(d.memberEmails.toSet()).size() == 0;
    }
    // A list is a to-do list, or a love letter: a written body shared with at most one person
    function kindOf(d) { return d.get('kind', 'list'); }
    function validBody(d) { return d.get('body', '') is string && d.get('body', '').size() <= 20000; }
    function validList(d) {
      return d.keys().hasOnly(['title', 'kind', 'body', 'ownerId', 'ownerEmail', 'ownerName', 'roles', 'memberEmails', 'leftEmails', 'archived', 'createdAt', 'updatedAt'])
        && d.title is string && d.title.size() >= 1 && d.title.size() <= 120
        && kindOf(d) in ['list', 'letter']
        && validBody(d)
        && (kindOf(d) == 'list' || d.memberEmails.size() <= 1)
        && d.get('archived', false) is bool
        && validRoles(d)
        && validLeft(d);
    }

    // ---------- users ----------
    match /users/{uid} {
      allow read, delete: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['email', 'displayName', 'lastListId', 'favorites', 'listOrder', 'spotify', 'music', 'notify', 'reminders', 'createdAt', 'updatedAt'])
        // due / overdue reminders I've marked read or removed: { read: [ids], gone: [ids] }
        && request.resource.data.get('reminders', {}) is map
        && request.resource.data.get('reminders', {}).keys().hasOnly(['read', 'gone'])
        && request.resource.data.get('reminders', {}).get('read', []) is list
        && request.resource.data.get('reminders', {}).get('read', []).size() <= 300
        && request.resource.data.get('reminders', {}).get('gone', []) is list
        && request.resource.data.get('reminders', {}).get('gone', []).size() <= 300
        // which kinds of device notifications I want: { share, tasks, comments, members, lists, music, chat } → true/false
        && request.resource.data.get('notify', {}) is map
        && request.resource.data.get('notify', {}).keys().hasOnly(['share', 'tasks', 'comments', 'members', 'lists', 'music', 'chat'])
        && request.resource.data.get('notify', {}).get('share', true) is bool
        && request.resource.data.get('notify', {}).get('tasks', true) is bool
        && request.resource.data.get('notify', {}).get('comments', true) is bool
        && request.resource.data.get('notify', {}).get('members', true) is bool
        && request.resource.data.get('notify', {}).get('lists', true) is bool
        && request.resource.data.get('notify', {}).get('music', true) is bool
        && request.resource.data.get('notify', {}).get('chat', true) is bool
        && request.resource.data.get('favorites', []) is list
        && request.resource.data.get('favorites', []).size() <= 500
        && request.resource.data.get('listOrder', []) is list
        && request.resource.data.get('listOrder', []).size() <= 500
        && request.resource.data.get('spotify', '') is string
        && request.resource.data.get('spotify', '').size() <= 200
        && request.resource.data.get('music', []) is list
        && request.resource.data.get('music', []).size() <= 100;
    }

    // ---------- people/{email}: name, photo and "last active", shown when someone taps your avatar on a shared list ----------
    // Only you write yours, and lastSeen is always the server's time. Anyone signed in can fetch one card by its
    // email (they must already know it), but nobody can list them.
    match /people/{email} {
      allow get: if signedIn();
      allow list: if false;
      allow create, update: if hasEmail() && email == myEmail()
        && request.resource.data.keys().hasOnly(['email', 'displayName', 'photoURL', 'online', 'lastSeen'])
        && request.resource.data.email == myEmail()
        && request.resource.data.displayName is string && request.resource.data.displayName.size() <= 120
        && request.resource.data.photoURL is string && request.resource.data.photoURL.size() <= 1000
        && request.resource.data.get('online', false) is bool
        && request.resource.data.lastSeen == request.time;
      allow delete: if hasEmail() && email == myEmail();
    }

    // ---------- my own activity ("You created …", "You added a song …"): only I can see it ----------
    match /users/{uid}/log/{logId} {
      function validLog(d) {
        return d.keys().hasOnly(['kind', 'text', 'detail', 'target', 'listId', 'listTitle', 'letter', 'seen', 'createdAt'])
          && d.kind is string && d.kind.size() >= 1 && d.kind.size() <= 40
          && d.get('text', '') is string && d.get('text', '').size() <= 200
          && d.get('detail', '') is string && d.get('detail', '').size() <= 200
          && d.get('target', '') is string && d.get('target', '').size() <= 200
          && d.get('listId', '') is string && d.get('listId', '').size() <= 200
          && d.get('listTitle', '') is string && d.get('listTitle', '').size() <= 120
          && d.get('letter', false) is bool
          && d.seen == false && d.createdAt == request.time;
      }
      allow read, delete: if signedIn() && request.auth.uid == uid;
      allow create: if signedIn() && request.auth.uid == uid && validLog(request.resource.data);
      allow update: if signedIn() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['seen'])
        && request.resource.data.seen is bool;
    }

    // ---------- lists ----------
    match /lists/{listId} {
      // owner, or anyone signed in with an email the list is shared to
      allow read: if signedIn() && (
        resource.data.ownerId == request.auth.uid
        || (hasEmail() && myEmail() in resource.data.memberEmails)
        // the owner shared their calendar with me (the app asks for kind == 'list')
        || (hasEmail() && resource.data.kind == 'list'
          && exists(/databases/$(database)/documents/calendarShares/$(resource.data.ownerId + '_' + myEmail())))
      );

      // anyone signed in can create their own list (shared with nobody yet)
      allow create: if hasEmail()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerEmail == myEmail()
        && request.resource.data.roles.size() == 0
        && validList(request.resource.data);

      allow update: if signedIn() && (
        // owner: rename, archive, share, change or remove access
        (resource.data.ownerId == request.auth.uid
          && request.resource.data.ownerId == resource.data.ownerId
          && request.resource.data.ownerEmail == resource.data.ownerEmail
          && kindOf(request.resource.data) == kindOf(resource.data)
          && validList(request.resource.data))
        // write roles (and shared calendars): only bump "last changed" when they edit tasks
        || (canWrite(effRole(resource.data))
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['updatedAt']))
        // write roles on a love letter: edit the letter itself
        || (canWrite(roleIn(resource.data)) && kindOf(resource.data) == 'letter'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['body', 'updatedAt'])
          && validBody(request.resource.data))
        // any member: leave the list (remove only yourself, and record that you left)
        || (hasEmail() && roleIn(resource.data) != null && roleIn(resource.data) != 'owner'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['roles', 'memberEmails', 'leftEmails'])
          && leftOf(request.resource.data).toSet() == leftOf(resource.data).toSet().union([myEmail()].toSet())
          && validLeft(request.resource.data)
          && resource.data.roles.diff(request.resource.data.roles).removedKeys() == [myEmail()].toSet()
          && resource.data.roles.diff(request.resource.data.roles).addedKeys().size() == 0
          && resource.data.roles.diff(request.resource.data.roles).changedKeys().size() == 0
          && validRoles(request.resource.data))
      );

      allow delete: if signedIn() && resource.data.ownerId == request.auth.uid;

      // ---------- tasks ----------
      match /tasks/{taskId} {
        function validTask(d) {
          return d.keys().hasOnly(['text', 'done', 'archived', 'due', 'start', 'mins', 'notes', 'location', 'links', 'createdBy', 'createdByName',
                                   'createdAt', 'updatedAt', 'updatedBy', 'updatedByName'])
            // optional time on the due day: start 'HH:MM', length in minutes
            && (d.get('start', null) == null || (d.start is string && d.start.matches('([01][0-9]|2[0-3]):[0-5][0-9]')))
            && (d.get('mins', null) == null || (d.mins is int && d.mins >= 5 && d.mins <= 1440))
            // optional notes: what's going to be done
            && (d.get('notes', '') is string && d.get('notes', '').size() <= 2000)
            // optional location: where it happens
            && (d.get('location', '') is string && d.get('location', '').size() <= 200)
            // optional links: [{ url, title }], up to 10 (the app checks each one is http(s))
            && (d.get('links', []) is list && d.get('links', []).size() <= 10)
            && d.text is string && d.text.size() >= 1 && d.text.size() <= 500
            && d.done is bool && d.archived is bool
            // optional due date: a whole day, 'YYYY-MM-DD'
            && (d.get('due', null) == null || (d.due is string && d.due.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')))
            && d.updatedBy == request.auth.uid;
        }

        allow read: if canRead(effRole(listData(listId)));
        allow create: if canWrite(effRole(listData(listId)))
          && validTask(request.resource.data)
          && request.resource.data.createdBy == request.auth.uid;
        allow update: if canWrite(effRole(listData(listId)))
          && validTask(request.resource.data)
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.createdAt == resource.data.createdAt;
        allow delete: if canWrite(effRole(listData(listId)));
      }

      // ---------- comments ----------
      match /comments/{commentId} {
        // the new likes list is the old one plus me (not there yet) or minus me (there), nothing else
        function likeToggle(before, after) {
          let me = [request.auth.uid].toSet();
          return after is list && (
            (!(request.auth.uid in before) && after.size() == before.size() + 1 && after.toSet() == before.toSet().union(me))
            || (request.auth.uid in before && after.size() == before.size() - 1 && after.toSet() == before.toSet().difference(me))
          );
        }
        allow read: if canComment(roleIn(listData(listId)));
        allow create: if canComment(roleIn(listData(listId)))
          && request.resource.data.keys().hasOnly(['text', 'userId', 'userName', 'userEmail', 'createdAt'])
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() >= 1 && request.resource.data.text.size() <= 2000;
        // edit your own comment (just its words), while you can still comment; it's marked as edited
        allow update: if canComment(roleIn(listData(listId))) && (
          (resource.data.userId == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'editedAt'])
            && request.resource.data.text is string
            && request.resource.data.text.size() >= 1 && request.resource.data.text.size() <= 2000
            && request.resource.data.editedAt == request.time)
          // ♥ any comment you can see: likes is a list of uids, and you may only add or remove your own
          || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes'])
            && likeToggle(resource.data.get('likes', []), request.resource.data.likes))
        );
        // delete your own comment; the owner can tidy any comment
        allow delete: if signedIn() && (
          resource.data.userId == request.auth.uid
          || listData(listId).ownerId == request.auth.uid
        );
      }
    }

    // ---------- in-app notifications: "X shared a list with you" ----------
    // Written by the owner in the same batch as the share, so getAfter() sees the new member.
    match /invites/{inviteId} {
      function ownsListAfter(d) {
        return getAfter(/databases/$(database)/documents/lists/$(d.listId)).data.ownerId == request.auth.uid;
      }
      function validInvite(d) {
        return d.keys().hasOnly(['to', 'listId', 'listTitle', 'fromName', 'fromEmail', 'permission', 'seen', 'createdAt'])
          && d.to is string && d.listId is string && d.listTitle is string && d.listTitle.size() <= 120
          && d.fromEmail == myEmail() && d.seen == false
          && ownsListAfter(d)
          && d.to in getAfter(/databases/$(database)/documents/lists/$(d.listId)).data.memberEmails;
      }

      allow read: if hasEmail() && resource.data.to == myEmail();
      allow create: if hasEmail() && validInvite(request.resource.data);
      allow update: if hasEmail() && (
        // owner shares again
        validInvite(request.resource.data)
        // recipient marks it as read (or unread again)
        || (resource.data.to == myEmail()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['seen'])
          && request.resource.data.seen is bool)
      );
      // recipient dismisses or leaves; owner removes access. Lists shared before
      // notifications existed have no invite doc, so deleting nothing is allowed.
      allow delete: if hasEmail() && (
        resource == null
        || resource.data.to == myEmail()
        || listData(resource.data.listId).ownerId == request.auth.uid
      );
    }

    // ---------- in-app notifications: "X did something on a list you share" ----------
    // Written in the same batch as the change itself, for someone else on the list.
    // get() sees the list as it was before the batch, so leaving, removing and deleting can still notify.
    //   comments            sent by someone who can comment, to people who can see the comments
    //   tasks and letters   sent by someone who can write, to anyone on the list
    //   the list itself     sent by the owner, to anyone on the list
    //   member-left         sent by the member who leaves, to anyone on the list
    // ---------- private chat (two people, like WhatsApp) ----------
    // chats/{a|b}: a and b are the two members' emails, sorted, so there's one chat per pair and it can only
    // ever have those two people. Nobody can add a third member, delete it, or read it from outside.
    match /chats/{chatId} {
      function isMember(d) { return hasEmail() && myEmail() in d.members; }
      // only my own entry in a map of { email: … } changes
      function onlyMine(field) {
        return request.resource.data.get(field, {}).diff(resource.data.get(field, {})).affectedKeys().hasOnly([myEmail()]);
      }
      function validNewChat(d) {
        return d.keys().hasOnly(['members', 'names', 'createdBy', 'createdAt', 'readAt', 'deliveredAt', 'typing'])
          && d.members is list && d.members.size() == 2
          && d.members[0] is string && d.members[1] is string
          && d.members[0] < d.members[1]
          && d.members[0] == d.members[0].lower() && d.members[1] == d.members[1].lower()
          && d.members[0].size() <= 254 && d.members[1].size() <= 254
          && myEmail() in d.members
          && chatId == d.members[0] + '|' + d.members[1]
          && d.createdBy == request.auth.uid && d.createdAt == request.time
          && d.names is map && d.names.keys().hasOnly([myEmail()])
          && d.get('readAt', {}) is map && d.get('deliveredAt', {}) is map && d.get('typing', {}) is map;
      }
      function validLast(l) {
        return l is map && l.keys().hasOnly(['text', 'from', 'at'])
          && l.from == myEmail() && l.text is string && l.text.size() <= 200 && l.at == request.time;
      }
      allow read: if isMember(resource.data);
      allow create: if validNewChat(request.resource.data);
      allow update: if isMember(resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['last', 'readAt', 'deliveredAt', 'typing', 'names'])
        && onlyMine('readAt') && onlyMine('deliveredAt') && onlyMine('typing') && onlyMine('names')
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['last']) || validLast(request.resource.data.last));

      match /messages/{messageId} {
        function chatData() { return get(/databases/$(database)/documents/chats/$(chatId)).data; }
        function inChat() { return hasEmail() && myEmail() in chatData().members; }
        function validReply(d) {
          return !('reply' in d) || (d.reply is map && d.reply.keys().hasOnly(['id', 'text', 'from'])
            && d.reply.id is string && d.reply.text is string && d.reply.text.size() <= 300 && d.reply.from is string);
        }
        allow read: if inChat();
        allow create: if inChat()
          && request.resource.data.keys().hasOnly(['from', 'text', 'createdAt', 'reply'])
          && request.resource.data.from == myEmail()
          && request.resource.data.text is string && request.resource.data.text.size() >= 1 && request.resource.data.text.size() <= 4000
          && request.resource.data.createdAt == request.time
          && validReply(request.resource.data);
        // my own messages: edit the text, or delete it for everyone (it stays as "This message was deleted")
        allow update: if inChat() && resource.data.from == myEmail() && resource.data.get('deleted', false) == false && (
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'editedAt'])
            && request.resource.data.text is string && request.resource.data.text.size() >= 1 && request.resource.data.text.size() <= 4000
            && request.resource.data.editedAt == request.time)
          || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'deleted', 'reply', 'editedAt'])
            && request.resource.data.deleted == true && request.resource.data.text == ''
            && !('reply' in request.resource.data) && !('editedAt' in request.resource.data))
        );
        allow delete: if false;
      }
    }

    // ---------- shared calendars ----------
    // calendarShares/{ownerUid}_{email}: the owner shares their whole calendar (every to-do list they own, now and
    // later) with that email, to see and change. The person it's for sees it (and marks it seen), or removes it.
    match /calendarShares/{shareId} {
      function validShare(d) {
        return d.keys().hasOnly(['ownerUid', 'ownerEmail', 'ownerName', 'to', 'seen', 'createdAt'])
          && d.ownerUid == request.auth.uid && d.ownerEmail == myEmail()
          && d.ownerName is string && d.ownerName.size() <= 120
          && d.to is string && d.to.size() >= 3 && d.to.size() <= 254 && d.to == d.to.lower() && d.to != myEmail()
          && shareId == request.auth.uid + '_' + d.to
          && d.seen == false && d.createdAt == request.time;
      }
      allow read: if hasEmail() && (resource.data.ownerUid == request.auth.uid || resource.data.to == myEmail());
      allow create: if hasEmail() && validShare(request.resource.data);
      allow update: if hasEmail() && resource.data.to == myEmail()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['seen'])
        && request.resource.data.seen is bool;
      allow delete: if hasEmail() && (resource.data.ownerUid == request.auth.uid || resource.data.to == myEmail());
    }

    match /activity/{activityId} {
      function mayActivity(kind, role) {
        return (kind in ['comment', 'comment-edit', 'comment-delete'] && canComment(role))
          || (kind in ['task-add', 'task-edit', 'task-done', 'task-undone', 'task-due', 'task-notes', 'task-archive',
                       'task-restore', 'task-delete', 'task-link', 'task-unlink', 'letter-edit'] && canWrite(role))
          || (kind in ['list-rename', 'list-archive', 'list-unarchive', 'list-delete',
                       'member-added', 'member-removed', 'access-changed', 'access-removed'] && role == 'owner')
          || (kind == 'member-left' && role != null && role != 'owner');
      }
      function mayReceive(kind, list, to) {
        return to == list.ownerEmail
          || (kind in ['comment', 'comment-edit', 'comment-delete']
            ? list.roles.get(to, '') in ['comment', 'readwrite']
            : to in list.memberEmails);
      }
      function validActivity(d) {
        return d.keys().hasOnly(['to', 'listId', 'listTitle', 'letter', 'kind', 'text', 'detail', 'fromName', 'fromEmail', 'seen', 'createdAt'])
          && d.to is string && d.to != myEmail()
          && d.listId is string
          && d.listTitle is string && d.listTitle.size() <= 120
          && d.get('letter', false) is bool
          && d.kind is string
          && d.get('text', '') is string && d.get('text', '').size() <= 200
          && d.get('detail', '') is string && d.get('detail', '').size() <= 200
          && d.fromName is string && d.fromName.size() <= 120
          && d.fromEmail == myEmail() && d.seen == false && d.createdAt == request.time
          && mayActivity(d.kind, effRole(listData(d.listId)))
          && mayReceive(d.kind, listData(d.listId), d.to);
      }

      allow read: if hasEmail() && resource.data.to == myEmail();
      allow create: if hasEmail() && validActivity(request.resource.data);
      // the person it's for marks it as read (or unread again), or removes it
      allow update: if hasEmail() && resource.data.to == myEmail()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['seen'])
        && request.resource.data.seen is bool;
      allow delete: if hasEmail() && resource.data.to == myEmail();
    }

    // ---------- device notifications: one push token per device that turned them on ----------
    // The id is the token itself. Only the server (/api/push, admin SDK) reads them, so the
    // browser can only save or remove its own, never list anyone's.
    match /pushTokens/{token} {
      function validToken(d) {
        return d.keys().hasOnly(['uid', 'email', 'device', 'createdAt', 'updatedAt'])
          && d.uid == request.auth.uid && d.email == myEmail()
          && d.device is string && d.device.size() <= 200
          && token.size() <= 4096;
      }
      allow read: if false;
      allow create: if hasEmail() && validToken(request.resource.data);
      // the same device signing in as someone else takes the token over
      allow update: if hasEmail() && validToken(request.resource.data);
      allow delete: if signedIn() && (resource == null || resource.data.uid == request.auth.uid);
    }

    // ---------- optional: invitation emails ----------
    // Only the list owner can queue an email, and only to someone already on that list.
    match /mail/{mailId} {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['to', 'message', 'listId', 'createdBy'])
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.listId is string
        && listData(request.resource.data.listId).ownerId == request.auth.uid
        && request.resource.data.to in listData(request.resource.data.listId).memberEmails
        && request.resource.data.message.keys().hasOnly(['subject', 'html', 'text'])
        && request.resource.data.message.subject.size() <= 200
        && request.resource.data.message.html.size() <= 5000;
      allow read, update, delete: if false;
    }
  }
}
